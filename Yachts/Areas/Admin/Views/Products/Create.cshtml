    let selectedFiles = [];

    $("#fileInput").on("change", function (e) {
        const files = Array.from(e.target.files);

        // 合併（避免覆蓋）
        selectedFiles = selectedFiles.concat(files);

        renderPreview();
    });

    function renderPreview() {
        $("#preview-container").html("");

        selectedFiles.forEach((file, index) => {
            const reader = new FileReader();

            reader.onload = function (e) {
                const html = `
                    <div class="preview-item" data-index="${index}" style="display:inline-block;margin:10px;">
                        <img src="${e.target.result}" width="120" style="display:block;border:1px solid #ccc;padding:5px;" />
                        <div style="width:120px;word-break:break-all;">${file.name}</div>
                        <button type="button" onclick="removeFile(${index})">移除</button>
                    </div>
                `;

                $("#preview-container").append(html);
            };

            reader.readAsDataURL(file);
        });
    }

    function removeFile(index) {
        selectedFiles.splice(index, 1);
        renderPreview();
    }
</script>