</div>
<!--換圖結束-->

<div class="conbg">
    <!--左邊選單開始-->
    <div class="left">

        <div class="left1">
            <p><span>Yachts</span></p>
            <ul>
                @foreach (var product in ViewBag.Products)
                {
                    <li><a href="/Yachts?product=@product">@product</a></li>
                }
            </ul>
        </div>
    </div>
    <!--左邊選單結束-->
    <!--右邊選單開始-->
    <div id="crumb"><a href="#">Home</a> >> <a href="#">Yachts</a> >> <a href="/Yachts?product=@ViewBag.Product"><span class="on1">@ViewBag.Product</span></a></div>
    <div class="right">
        <div class="right1">
            <div class="title"> <span>@ViewBag.Product</span></div>

            <!--內容開始-->
            <!--次選單-->
            <div class="menu_y">
                @foreach (var item in Model)
                {
                    <ul>
                        <li class="menu_y00">YACHTS</li>
                        <li><a class="menu_yli01" href="#">Interior</a></li>
                        <li><a class="menu_yli02" href="@Url.Action("DeskPlan", "Yachts", new {id=item.Id})">Layout & deck plan</a>n</li>
                        <li><a class="menu_yli03" href="@Url.Action("Specification", "Yachts", new {id=item.Id})">Specification</a></li>
                    </ul>
                }
            </div>
            <!--次選單-->

            <div class="box1">
                @foreach (var item in Model)
                {
                    @Html.DisplayFor(modelItem => item.Structual)
                }

               <br /><br />
            </div>

            <div class="box3">
                <h4>PRINCIPAL DIMENSION</h4>
                <table class="table02">
                    <tr>
                        <td class="table02td01">
                            <table>
                                @{
                                    int rowIndex = 0;
                                }
                                @foreach (var item in Model)
                                {
                                    foreach (var size in item.Sizes)
                                    {
                                            var rowClass = (rowIndex % 2 == 1) ? "tr003" : "";
                                            <tr class="@rowClass">
                                                <th>@size.DimensionName</th>
                                                <td>@size.DimensionValue</td>
                                            </tr>
                                        rowIndex++;
                                    }
                                }
                            </table>
                        </td>
                        <td><img src="~/Images/ya01.jpg" alt="&quot;&quot;" width="278" height="345" /></td>
                    </tr>
                </table>


            </div>
            <p class="topbuttom"><img src="~/Images/top.gif" alt="top" /></p>

            <!--下載開始-->
            <div class="downloads">
                <p><img src="~/Images/downloads.gif" alt="&quot;&quot;" /></p>
                <ul>
                    <li><a href="#">Downloads 001</a></li>
                    <li><a href="#">Downloads 001</a></li>
                    <li><a href="#">Downloads 001</a></li>
                    <li><a href="#">Downloads 001</a></li>
                    <li><a href="#">Downloads 001</a></li>

                </ul>
            </div>
            <!--下載結束-->
            <!--內容結束-->
        </div>
    </div>
    <!--右邊選單結束-->
</div>
